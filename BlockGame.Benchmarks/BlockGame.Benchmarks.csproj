<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>BlockGame.Benchmarks</RootNamespace>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <StartupObject>BlockGame.Benchmarks.Program</StartupObject>
    <EngineProjectPath Condition="'$(EngineProjectPath)' == ''">$(MSBuildThisFileDirectory)../BlockGame.Core/BlockGame.Core.csproj</EngineProjectPath>
    <EngineContentRoot>$([System.IO.Path]::GetDirectoryName('$(EngineProjectPath)'))/../BlockGame/Content</EngineContentRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <ProjectReference Include="$(EngineProjectPath)" />
    <EmbeddedResource Include="Workloads/FrozenTerrain.json" LogicalName="FrozenTerrain.json" />
    <Content Include="$(EngineContentRoot)/**/*.png;$(EngineContentRoot)/**/*.json"
             Link="Content/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
