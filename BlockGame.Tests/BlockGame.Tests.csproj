<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\BlockGame\BlockGame.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Update="..\BlockGame\FastNoise.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>FastNoise.dll</Link>
        </None>
        <None Update="..\BlockGame\NodeEditorIpc.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>NodeEditorIpc.dll</Link>
        </None>
        <Content Include="..\BlockGame\Content\**\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>Content\%(RecursiveDir)%(FileName)%(Extension)</Link>
        </Content>
    </ItemGroup>

</Project>
