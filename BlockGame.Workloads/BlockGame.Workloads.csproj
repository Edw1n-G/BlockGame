<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EngineProjectPath Condition="'$(EngineProjectPath)' == ''">$(MSBuildThisFileDirectory)../BlockGame/BlockGame.csproj</EngineProjectPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(EngineProjectPath)" />
    <ProjectReference Include="../BlockGame.Benchmarking/BlockGame.Benchmarking.csproj" />
    <EmbeddedResource Include="FrozenTerrain.json" Condition="Exists('FrozenTerrain.json')" />
  </ItemGroup>
</Project>
